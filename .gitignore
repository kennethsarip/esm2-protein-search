# data artifacts, never committed. No trailing slash: CLAUDE.md 5.2 suggests
# symlinking data/ to one shared copy, and git treats a symlink as a file, so
# a "data/" pattern would not ignore it.
/data
eval/data/
*.npy
*.parquet
*.onnx
*.fasta
*.fasta.gz
*.h5

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# rust
target/
**/*.rs.bk

# terraform
.terraform/
.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
crash.log

# node
node_modules/
dist/
.vite/

# secrets and env
.env
.env.*
!.env.example
*.pem
credentials

# os and editor
.DS_Store
.idea/
*.swp
